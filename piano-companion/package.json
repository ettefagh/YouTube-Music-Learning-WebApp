{
	"name": "piano-companion",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name=piano-practice-companion --branch=main"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.0",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/youtube": "^0.3.0",
		"playwright": "^1.62.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.41.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"dexie": "^4.4.5",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260903.1": true
	}
}
