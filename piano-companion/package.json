{
	"name": "piano-companion",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name=piano-practice-companion --branch=main"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0-next.0",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/youtube": "^0.3.0",
		"playwright": "^1.62.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0"
	},
	"dependencies": {
		"dexie": "^4.4.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
