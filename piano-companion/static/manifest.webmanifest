{
  "name": "Piano Practice Companion",
  "short_name": "Piano Companion",
  "description": "A piano practice app with YouTube looper, dual audio studio, and gamified practice checkpoints",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#FF0033",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
